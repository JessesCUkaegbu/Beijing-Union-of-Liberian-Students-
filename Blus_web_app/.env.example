# ══════════════════════════════════════════════════════════════════════
# BLUS Web App — Environment Variables Reference
# ══════════════════════════════════════════════════════════════════════
# Copy this file to .env for local development.
# For Railway, add these as env vars in the project dashboard (not a file).
# ══════════════════════════════════════════════════════════════════════

# ── Core flags ─────────────────────────────────────────────────────────
# LOCAL:   IS_PRODUCTION=False  DEBUG=True
# RAILWAY: IS_PRODUCTION=True   DEBUG=False
IS_PRODUCTION=False
DEBUG=True

# Generate a key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Optional. DEBUG, INFO, WARNING, or ERROR. Defaults to DEBUG when DEBUG=True, INFO otherwise.
# LOG_LEVEL=INFO

# ── Hosts / CSRF ───────────────────────────────────────────────────────
# Comma-separated. CSRF values MUST include the scheme (https://).
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.up.railway.app
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://yourdomain.up.railway.app

# ── Database ───────────────────────────────────────────────────────────
# RAILWAY: injected automatically by the PostgreSQL plugin — do NOT set manually.
# LOCAL:   leave commented out to use SQLite.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# ── CORS (optional — only for a separate frontend SPA) ──────────────────
# CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Media storage (optional) ────────────────────────────────────────────
# Leave all unset to keep using local disk (fine for local dev). Set
# AWS_STORAGE_BUCKET_NAME (at minimum) to switch to S3-compatible storage —
# do this in production so uploads survive Railway redeploys (its filesystem
# is ephemeral). Works with real AWS S3 or any S3-compatible provider.
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
