# ══════════════════════════════════════════════════════════════════════
# BLUS Web App — Environment Variables Reference
# ══════════════════════════════════════════════════════════════════════
# Copy this file to .env for local development.
# For Railway, add these as env vars in the project dashboard (not a file).
# ══════════════════════════════════════════════════════════════════════

# ── Core flags ─────────────────────────────────────────────────────────
# LOCAL:   IS_PRODUCTION=False  DEBUG=True
# RAILWAY: IS_PRODUCTION=True   DEBUG=False
IS_PRODUCTION=False
DEBUG=True

# Generate a key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# ── Hosts / CSRF ───────────────────────────────────────────────────────
# Comma-separated. CSRF values MUST include the scheme (https://).
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.up.railway.app
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://yourdomain.up.railway.app

# ── Database ───────────────────────────────────────────────────────────
# RAILWAY: injected automatically by the PostgreSQL plugin — do NOT set manually.
# LOCAL:   leave commented out to use SQLite.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# ── CORS (optional — only for a separate frontend SPA) ──────────────────
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
