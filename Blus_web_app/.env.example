# ══════════════════════════════════════════════════════════════════════
# BLUS Web App — Environment Variables Reference
# ══════════════════════════════════════════════════════════════════════
# Copy this file to .env for local development.
# For Railway production, add these as environment variables in the
# Railway project dashboard (not as a committed file).
# ══════════════════════════════════════════════════════════════════════

# ── Django core ────────────────────────────────────────────────────────
# Generate a secure key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-min-50-chars-here

# Set to False in production
DEBUG=False

# Comma-separated. Add your Railway domain + any custom domain.
ALLOWED_HOSTS=yourdomain.up.railway.app,yourdomain.com

# Must include https:// for Railway and any custom domain.
CSRF_TRUSTED_ORIGINS=https://yourdomain.up.railway.app,https://yourdomain.com

# ── Database ───────────────────────────────────────────────────────────
# RAILWAY POSTGRESQL PLUGIN:
#   Railway injects $DATABASE_URL automatically when you add a PostgreSQL
#   plugin to your project. You do NOT need to set this manually on Railway.
#   Copy the value from Railway's "Variables" tab if you need it locally.
#
# FORMAT: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:password@monorail.proxy.rlwy.net:12345/railway

# ── Connection pooling ─────────────────────────────────────────────────
# Seconds to keep DB connections alive. 60 is a safe default.
CONN_MAX_AGE=60

# ── CORS (optional — only needed if running a separate frontend SPA) ────
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
