# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ────────────────────────────────────────────────────────
.venv/
venv/
env/
myenv/
ENV/

# ── Django ──────────────────────────────────────────────────────────────────────
*.sqlite3
db.sqlite3
media/
staticfiles/       # generated by collectstatic — never commit
local_settings.py

# ── Environment variables ───────────────────────────────────────────────────────
.env
.env.local
.env.*.local
# .env.example is intentionally NOT ignored — it should be committed.

# ── Node ────────────────────────────────────────────────────────────────────────
node_modules/
dist/
npm-debug.log*
yarn-error.log*

# ── IDE / Editor ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Build / packaging ───────────────────────────────────────────────────────────
*.egg-info/
dist/
build/
.eggs/

# ── Logs ────────────────────────────────────────────────────────────────────────
*.log
logs/
